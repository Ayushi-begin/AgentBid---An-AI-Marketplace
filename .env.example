# ==============================================================================
# AgentBid AI Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN THE RELEVANT VALUES
# NEVER COMMIT THE ACTUAL .env FILE OR ANY PRIVATE KEYS TO VERSION CONTROL!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Database (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql://marketplace:password@localhost:5432/marketplace
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Blockchain / Web3 Escrow Settings
# Supported demo networks: Sepolia, Base Sepolia, Arbitrum Sepolia, Hardhat Local (31337)
CHAIN_ID=11155111
EVM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_OR_ALCHEMY_KEY
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_PRIVATE_KEY=
WEB3_CONFIRMATION_BLOCKS=2

# AI Agent Service & LLM Configuration (Optional for initial deterministic phase)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS_PER_TASK=4096
TASK_TIMEOUT_SECONDS=120

# Security & Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-very-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
